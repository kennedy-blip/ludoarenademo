# Supabase (project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never expose to the browser. Used by server actions to write
# authoritative match results, wallet ledger rows and tournament standings.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Wallet / economy switches (safe defaults for a demo deployment)
# "demo" simulates M-Pesa STK push so the site works without Daraja creds.
MPESA_MODE=demo
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_CALLBACK_URL=https://your-domain/api/mpesa/callback
